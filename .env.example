# Copy to .env and replace every change-me value.
# Generate secrets with: openssl rand -hex 16

# --- Postgres superuser (used only by the init script and admin work)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- One least-privilege user per database (created by infra/postgres/init/01-create-dbs.sh)
ICEBERG_DB_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me

# --- SeaweedFS S3 admin credentials (path-style, http://localhost:8333)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# --- Where clients reach the services (laptop defaults; inside Docker use postgres / http://seaweedfs:8333)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
S3_ENDPOINT=http://localhost:8333
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse
# MLflow tracking server (inside Docker: http://mlflow:5000)
MLFLOW_TRACKING_URI=http://localhost:5050

# --- Valkey (Feast online store)
VALKEY_PASSWORD=change-me
VALKEY_HOST=localhost
VALKEY_PORT=6379

# --- Airflow
# Fernet key encrypts connections/variables in the airflow DB:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_PASSWORD=change-me

# Silence an MLflow log hint printed at import time
MLFLOW_DISABLE_AGENT_HINT=1
